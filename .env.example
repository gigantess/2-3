# ----------------------------------------------------
# Paradox Mind - 환경 변수 설정 샘플 (.env.example)
# ----------------------------------------------------
# 사용 방법:
# 1. 이 파일을 복사하여 프로젝트 루트에 '.env' 파일로 저장하세요.
# 2. 아래 항목에 실제 사용할 API 키 및 Webhook URL을 입력하세요.
# 3. 주의: '.env' 파일은 절대로 Git 저장소에 커밋하지 마세요! (.gitignore에 등록됨)

# [필수] Gemini API 키 (https://aistudio.google.com/ 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# [보너스] Discord Webhook URL (처방전 디스코드 전송 기능)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
